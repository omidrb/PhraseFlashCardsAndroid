<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="?android:colorBackground">

 <LinearLayout android:id="@+id/libraryView" android:orientation="vertical"
  android:paddingLeft="30dp" android:paddingRight="30dp" android:paddingTop="30dp" android:paddingBottom="30dp"
  android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent">

  <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="48dp">
   <ImageView android:id="@+id/titleIcon" android:src="@drawable/zope_title_icon" android:scaleType="centerCrop"
    android:layout_marginEnd="7dp" android:layout_width="36dp" android:layout_height="36dp"/>
   <TextView android:id="@+id/title" android:text="Zope Flash Cards v8.5" android:textSize="19sp" android:textStyle="bold"
    android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
   <Button android:id="@+id/menuButton" android:text="☰ Menu" android:textAllCaps="false" android:textSize="12sp"
    android:layout_width="88dp" android:layout_height="38dp"/>
  </LinearLayout>

  <FrameLayout android:layout_width="match_parent" android:layout_height="42dp">
   <TextView android:id="@+id/currentLanguage" android:text="English" android:textStyle="bold" android:textSize="17sp"
    android:gravity="center" android:layout_gravity="center" android:layout_width="match_parent" android:layout_height="match_parent"/>
   <TextView android:id="@+id/cardCount" android:text="0 cards" android:textSize="12sp"
    android:layout_gravity="end|center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </FrameLayout>

  <EditText android:id="@+id/search" android:hint="Search cards..." android:singleLine="true" android:drawableStart="@android:drawable/ic_menu_search" android:drawablePadding="8dp"
   android:paddingLeft="12dp" android:paddingRight="12dp" android:textSize="14sp"
   android:layout_width="match_parent" android:layout_height="42dp"/>

  <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp"
   android:layout_width="match_parent" android:layout_height="7dp">
   <View android:id="@+id/goodProgress" android:background="#22C55E" android:layout_width="0dp" android:layout_height="match_parent"/>
   <View android:id="@+id/hardProgress" android:background="#EF4444" android:layout_width="0dp" android:layout_height="match_parent"/>
   <View android:id="@+id/unseenProgress" android:background="#94A3B8" android:layout_width="0dp" android:layout_height="match_parent"/>
  </LinearLayout>
  <TextView android:id="@+id/stats" android:textSize="10sp" android:gravity="center"
   android:layout_width="match_parent" android:layout_height="18dp"/>

  <LinearLayout android:id="@+id/selectionBar" android:visibility="gone" android:gravity="center_vertical"
   android:paddingLeft="4dp" android:paddingRight="4dp" android:layout_width="match_parent" android:layout_height="48dp">
   <TextView android:id="@+id/selectedCount" android:text="0 selected" android:textStyle="bold"
    android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
   <Button android:id="@+id/selectAll" android:text="Select All" android:textAllCaps="false" android:textSize="11sp"
    android:layout_width="88dp" android:layout_height="40dp"/>
   <Button android:id="@+id/moveSelected" android:text="Move Box" android:textAllCaps="false"
    android:layout_width="72dp" android:layout_height="40dp"/>
   <Button android:id="@+id/deleteSelected" android:text="Delete" android:textAllCaps="false"
    android:backgroundTint="#EF4444" android:textColor="#FFFFFF"
    android:layout_width="82dp" android:layout_height="40dp"/>
   <Button android:id="@+id/cancelSelection" android:text="✕" android:textAllCaps="false"
    android:layout_width="48dp" android:layout_height="40dp"/>
  </LinearLayout>

  <ScrollView android:fillViewport="true" android:layout_weight="1"
   android:layout_width="match_parent" android:layout_height="0dp">
   <GridLayout android:id="@+id/cardGrid" android:columnCount="3" android:alignmentMode="alignMargins"
    android:useDefaultMargins="false" android:paddingTop="4dp" android:paddingBottom="8dp"
    android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </ScrollView>

  <LinearLayout android:orientation="horizontal" android:layout_marginTop="3dp"
   android:layout_width="match_parent" android:layout_height="62dp">
   <Button android:id="@+id/add" android:text="+ Add Card" android:textAllCaps="false" android:textSize="17sp" android:textStyle="bold" android:backgroundTint="#2563EB" android:textColor="#FFFFFF"
    android:layout_marginEnd="4dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
   <Button android:id="@+id/daily" android:text="Daily Practice" android:textAllCaps="false" android:textSize="17sp" android:textStyle="bold"
    android:backgroundTint="#2563EB" android:textColor="#FFFFFF" android:layout_marginStart="4dp"
    android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
  </LinearLayout>
 </LinearLayout>

 <LinearLayout android:id="@+id/practiceView" android:visibility="gone" android:orientation="vertical"
  android:paddingLeft="30dp" android:paddingRight="30dp" android:paddingTop="30dp" android:paddingBottom="30dp"
  android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent">

  <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="44dp">
   <Button android:id="@+id/backLibrary" android:text="← Library" android:textAllCaps="false"
    android:layout_width="105dp" android:layout_height="38dp"/>
   <TextView android:id="@+id/practiceProgress" android:text="Daily Practice 1 / 10" android:textStyle="bold"
    android:gravity="right" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
  </LinearLayout>

  <LinearLayout android:id="@+id/studyArea" android:orientation="vertical" android:gravity="center"
   android:padding="12dp" android:layout_marginTop="5dp" android:layout_marginBottom="5dp"
   android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp">
   <TextView android:id="@+id/phrase" android:gravity="center" android:textStyle="bold" android:textSize="28sp"
    android:maxLines="4" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <LinearLayout android:id="@+id/answerBox" android:visibility="gone" android:orientation="vertical"
    android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:text="English meaning" android:textColor="#3B82F6" android:textStyle="bold" android:textSize="12sp"
     android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/meaningEnglish" android:textSize="19sp" android:textStyle="bold"
     android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="معنی فارسی" android:textColor="#3B82F6" android:textStyle="bold" android:textSize="12sp"
     android:layout_marginTop="7dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/meaningPersian" android:textSize="20sp" android:textStyle="bold" android:gravity="right"
     android:textDirection="rtl" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Usage" android:textColor="#3B82F6" android:textStyle="bold" android:textSize="12sp"
     android:layout_marginTop="7dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/note" android:textSize="15sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Example" android:textColor="#3B82F6" android:textStyle="bold" android:textSize="12sp"
     android:layout_marginTop="7dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/example" android:textSize="17sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   </LinearLayout>
  </LinearLayout>

  <Button android:id="@+id/show" android:text="Show Answer" android:textAllCaps="false" android:textStyle="bold"
   android:layout_width="match_parent" android:layout_height="48dp"/>
  <Space android:layout_width="match_parent" android:layout_height="12dp"/>
  <LinearLayout android:id="@+id/rating" android:visibility="gone" android:orientation="horizontal"
   android:layout_width="match_parent" android:layout_height="58dp">
   <Button android:id="@+id/hard" android:text="Hard" android:textAllCaps="false" android:textSize="18sp" android:textStyle="bold"
    android:backgroundTint="#EF4444" android:textColor="#FFFFFF" android:layout_marginEnd="5dp"
    android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
   <Button android:id="@+id/good" android:text="Good" android:textAllCaps="false" android:textSize="18sp" android:textStyle="bold"
    android:backgroundTint="#22C55E" android:textColor="#FFFFFF" android:layout_marginStart="5dp"
    android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
  </LinearLayout>
  <Space android:layout_width="match_parent" android:layout_height="28dp"/>
 </LinearLayout>
</FrameLayout>