<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="Phrase Flash Cards" android:textSize="25sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/english" android:text="English" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
<Button android:id="@+id/norwegian" android:text="Norwegian" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
</LinearLayout>
<TextView android:id="@+id/stats" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/phrase" android:gravity="center" android:textStyle="bold" android:textSize="30sp" android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp"/>
<LinearLayout android:id="@+id/answerBox" android:visibility="gone" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/translation" android:gravity="center" android:textStyle="bold" android:textSize="20sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/note" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/example" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<Button android:id="@+id/show" android:text="Show answer" android:backgroundTint="#E5E7EB" android:textColor="#111827" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/rating" android:visibility="gone" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/hard" android:text="Hard" android:backgroundTint="#EF4444" android:textColor="#FFFFFF" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
<Button android:id="@+id/good" android:text="Good" android:backgroundTint="#22C55E" android:textColor="#FFFFFF" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/add" android:text="+ Add" android:backgroundTint="#E5E7EB" android:textColor="#111827" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
<Button android:id="@+id/manage" android:text="Manage" android:backgroundTint="#E5E7EB" android:textColor="#111827" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
</LinearLayout>
</LinearLayout>