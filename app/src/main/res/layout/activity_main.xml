<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:orientation="vertical" android:background="#F8FAFC"
 android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="8dp"
 android:paddingBottom="28dp" android:fitsSystemWindows="true"
 android:layout_width="match_parent" android:layout_height="match_parent">

 <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="42dp">
  <TextView android:text="Phrase Flash Cards" android:textColor="#0F172A" android:textSize="20sp" android:textStyle="bold"
   android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
  <Button android:id="@+id/addDeck" android:text="+ Language" android:textSize="11sp" android:textAllCaps="false"
   android:backgroundTint="#E8F1FF" android:textColor="#2563EB" android:minHeight="36dp"
   android:layout_width="wrap_content" android:layout_height="36dp"/>
 </LinearLayout>

 <HorizontalScrollView android:scrollbars="none" android:fillViewport="false"
  android:layout_width="match_parent" android:layout_height="46dp">
  <LinearLayout android:id="@+id/deckButtons" android:orientation="horizontal"
   android:layout_width="wrap_content" android:layout_height="match_parent"/>
 </HorizontalScrollView>

 <TextView android:id="@+id/cardNumber" android:textColor="#64748B" android:textSize="12sp" android:gravity="center"
  android:layout_width="match_parent" android:layout_height="18dp"/>

 <LinearLayout android:orientation="horizontal" android:layout_marginTop="2dp"
  android:layout_width="match_parent" android:layout_height="9dp">
  <View android:id="@+id/goodProgress" android:background="#22C55E" android:layout_width="0dp" android:layout_height="match_parent"/>
  <View android:id="@+id/hardProgress" android:background="#EF4444" android:layout_width="0dp" android:layout_height="match_parent"/>
  <View android:id="@+id/unseenProgress" android:background="#E2E8F0" android:layout_width="0dp" android:layout_height="match_parent"/>
 </LinearLayout>

 <TextView android:id="@+id/stats" android:textColor="#64748B" android:textSize="11sp" android:gravity="center"
  android:layout_width="match_parent" android:layout_height="22dp"/>

 <LinearLayout android:id="@+id/studyArea" android:orientation="vertical" android:gravity="center"
  android:background="#FFFFFF" android:elevation="2dp" android:padding="14dp"
  android:layout_marginTop="4dp" android:layout_marginBottom="6dp"
  android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp">
  <TextView android:id="@+id/phrase" android:gravity="center" android:textColor="#0F172A"
   android:textStyle="bold" android:textSize="27sp" android:maxLines="3"
   android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <View android:background="#E2E8F0" android:layout_marginTop="10dp" android:layout_marginBottom="8dp"
   android:layout_width="match_parent" android:layout_height="1dp"/>
  <LinearLayout android:id="@+id/answerBox" android:visibility="gone" android:orientation="vertical"
   android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:text="Meaning" android:textColor="#2563EB" android:textStyle="bold" android:textSize="13sp"
    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <TextView android:id="@+id/translation" android:textColor="#0F172A" android:textStyle="bold" android:textSize="21sp"
    android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <TextView android:id="@+id/note" android:textColor="#475569" android:textSize="16sp" android:layout_marginTop="6dp"
    android:maxLines="3" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <TextView android:text="Example" android:textColor="#2563EB" android:textStyle="bold" android:textSize="13sp"
    android:layout_marginTop="7dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <TextView android:id="@+id/example" android:textColor="#0F172A" android:textSize="18sp" android:maxLines="3"
    android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </LinearLayout>
 </LinearLayout>

 <TextView android:text="← Swipe to browse without rating →" android:textColor="#94A3B8" android:textSize="10sp"
  android:gravity="center" android:layout_width="match_parent" android:layout_height="16dp"/>

 <Button android:id="@+id/show" android:text="Show answer" android:textAllCaps="false" android:textStyle="bold"
  android:backgroundTint="#E5E7EB" android:textColor="#111827"
  android:layout_width="match_parent" android:layout_height="48dp"/>

 <LinearLayout android:id="@+id/rating" android:visibility="gone" android:orientation="horizontal"
  android:layout_width="match_parent" android:layout_height="62dp">
  <Button android:id="@+id/hard" android:text="☹  Hard" android:textAllCaps="false" android:textSize="18sp" android:textStyle="bold"
   android:backgroundTint="#FF3030" android:textColor="#FFFFFF" android:layout_marginEnd="5dp"
   android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
  <Button android:id="@+id/good" android:text="☺  Good" android:textAllCaps="false" android:textSize="18sp" android:textStyle="bold"
   android:backgroundTint="#20B84B" android:textColor="#FFFFFF" android:layout_marginStart="5dp"
   android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
 </LinearLayout>

 <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp"
  android:layout_width="match_parent" android:layout_height="44dp">
  <Button android:id="@+id/add" android:text="+ Add Card" android:textAllCaps="false" android:textSize="12sp"
   android:backgroundTint="#E5E7EB" android:textColor="#334155" android:layout_marginEnd="4dp"
   android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
  <Button android:id="@+id/manage" android:text="Manage Cards" android:textAllCaps="false" android:textSize="12sp"
   android:backgroundTint="#E5E7EB" android:textColor="#334155" android:layout_marginStart="4dp"
   android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/>
 </LinearLayout>

 <!-- Deliberate safe-area spacer: keeps controls above Samsung gesture/navigation area -->
 <Space android:layout_width="match_parent" android:layout_height="22dp"/>
</LinearLayout>